<!doctype html>
<html lang="fr">

<head>
    <title>Atlas des centres-villes</title>
    <link rel="shortcut icon" href="img/logo_fnau.png" type="image/x-icon">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
    <link rel="stylesheet" href="https://unpkg.com/maplibre-gl@6.19.0/dist/maplibre-gl.css">
    <script type="importmap">
        {
            "imports": {
                "leaflet": "https://unpkg.com/leaflet@1.9.4/dist/leaflet-src.esm.js",
                "maplibre-gl": "https://unpkg.com/maplibre-gl@6.19.0/dist/maplibre-gl.mjs",
                "@maplibre/maplibre-gl-leaflet": "https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.4/dist/leaflet-maplibre-gl.mjs",
                "@maplibre/maplibre-gl-leaflet/": "https://unpkg.com/@maplibre/maplibre-gl-leaflet@0.1.4/"
            }
        }
    </script>
    <script>
        window.webmappingReady = new Promise(resolve => {
            window.addEventListener('webmapping-ready', resolve, { once: true });
        });
        window.cityListReady = fetch('/villes').then(response => {
            if (!response.ok) throw new Error('Unable to load commune names');
            return response.json();
        }).then(cities => {
            window.villes = cities.map(city => `${city.nom_com} (${city.codgeo})`);
            return window.villes;
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>

<body>
    <header>
        <div>
            <a href="https://www.fnau.org/fr/publication/atlas-des-centres-villes/"> 
                <h1>ATLAS DES CENTRES</h1>
            </a>
            <a href="https://www.fnau.org/fr/accueil/">
                <img id="logo" src="img/logo-white.png" alt="Logo de la fnau">
            </a>
        </div>
    </header>
    <div class="container">